{
  "manifest_version": 3,
  "name": "ChatChat — AI Council",
  "version": "0.9.0",
  "description": "Your local AI Council. Attach logged-in AI tabs, ask once, and let the House debate.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open ChatChat AI Council"
  },
  "side_panel": {
    "default_path": "extension/sidepanel.html"
  }
}
